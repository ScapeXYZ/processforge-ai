# Public browser configuration (Supabase publishable values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-publishable-or-anon-key

# Server-only application and provider configuration
APP_BASE_URL=https://processforgeai.xyz
SUPABASE_SERVICE_ROLE_KEY=replace-in-host-secret-manager
OPENAI_API_KEY=replace-in-host-secret-manager

# Paid agent emergency switch and official OKX x402 provider
AGENT_PAID_GENERATION_ENABLED=false
OKX_X402_ENABLED=false
OKX_X402_MOCK=false
OKX_X402_NETWORK=eip155:196
# Public recipient address only; never configure a recipient private key.
OKX_X402_PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
OKX_X402_ASSET=USDT
OKX_X402_ASSET_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
OKX_X402_ASSET_DECIMALS=6
# Positive integer in smallest units (10000 = 0.01 USDT at 6 decimals).
OKX_X402_PRICE=10000
OKX_X402_FACILITATOR_URL=https://web3.okx.com
OKX_X402_API_KEY=replace-in-host-secret-manager
OKX_X402_SECRET_KEY=replace-in-host-secret-manager
OKX_X402_PASSPHRASE=replace-in-host-secret-manager
OKX_X402_TIMEOUT_SECONDS=120

# Operations
LOG_LEVEL=info
RATE_LIMIT_STORE=distributed-adapter-required-for-multiple-instances
ENABLE_RELEASE_CHECK=false
MARKETPLACE_AUTO_APPROVE=false
DEPLOYMENT_VERSION=replace-with-release-version
GIT_COMMIT_SHA=replace-with-deployed-commit
